op.rail_fence.decode.desc = Rail Fence cipher decode (zig-zag transposition)
op.rail_fence.arg.rails = Number of rails (default 3)
op.rail_fence.arg.offset = Plaintext rotation offset before laying out (default 0)
op.luhn.desc = Luhn (mod-10) checksum: compute check digit, append it, or verify a number
op.luhn.arg.mode = Mode: check-digit (default) / append / verify

# generate family (de Bruijn / prime / HOTP / TOTP)
op.de.bruijn.desc = Generate a De Bruijn sequence over digits 0..k-1 (FKM Lyndon-word construction)
op.de.bruijn.arg.size = Alphabet size k (2-9)
op.de.bruijn.arg.order = Substring order n (>= 2; k^n <= 50000)
op.prime.desc = Generate a random probable prime of the given bit length (Miller-Rabin)
op.prime.arg.bits = Bit length (2-4096)
op.prime.arg.grade = Cryptographic grade: 40 rounds instead of 7 (default: false)
op.prime.arg.format = Output format: decimal (default) / hex
op.hotp.desc = Generate an HMAC-based one-time password (RFC 4226, SHA-1, dynamic truncation)
op.hotp.arg.key = Shared secret as base32 (A-Z2-7); empty generates a random 20-byte secret
op.hotp.arg.digits = Code length: 6 / 7 / 8 (default 6)
op.hotp.arg.counter = Moving counter value (default 0)
op.totp.desc = Generate a time-based one-time password (RFC 6238, SHA-1)
op.totp.arg.key = Shared secret as base32 (A-Z2-7); empty generates a random 20-byte secret
op.totp.arg.digits = Code length: 6 / 7 / 8 (default 6)
op.totp.arg.period = Time step T1 in seconds (default 30)
op.totp.arg.epoch = Time origin T0 in Unix seconds (default 0)
op.totp.arg.time = Unix time to evaluate (seconds; default: now)


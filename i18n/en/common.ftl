# Examples (op.<name>.example, kept in sync with apply_examples in ops/mod.rs)
op.sort.example = Sort lines alphabetically:\ndpa op sort words.txt\nSort by numeric value:\ndpa op sort --type numeric numbers.txt
op.unique.example = Deduplicate adjacent duplicate lines:\ndpa op unique words.txt
op.count.example = Count lines (wc -l style):\ndpa op count --mode lines words.txt
op.replace.example = Replace first match per line:\ndpa op replace --pattern foo --replacement bar words.txt
op.aes.encrypt.example = AES-256-CBC with hex key and IV:\ndpa op aes:encrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 000102030405060708090a0b0c0d0e0f plain.bin
op.aes.decrypt.example = Decrypt AES-CBC output:\ndpa op aes:decrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 000102030405060708090a0b0c0d0e0f cipher.bin
op.hmac.example = HMAC-SHA256 with a hex key:\ndpa op hmac --key 00112233445566778899aabbccddeeff --algo sha256 data.bin
op.base64.encode.example = Encode to Base64:\necho hello | dpa op base64:encode
op.base64.decode.example = Decode Base64:\necho aGVsbG8= | dpa op base64:decode
op.hex.encode.example = Encode bytes to hex:\necho hello | dpa op hex:encode\nHex with colon separators:\ndpa op hex:encode --delimiter : data.bin
op.hex.decode.example = Decode hex back to bytes:\necho 68656c6c6f | dpa op hex:decode
op.url.encode.example = URL-encode a string:\necho "a b&c" | dpa op url:encode
op.timestamp.to.date.example = Convert epoch milliseconds to a date:\ndpa op timestamp:to:date 1728000000000 --unit ms
op.json.to.yaml.example = Convert JSON to YAML:\ndpa op json:to-yaml data.json
op.yaml.to.json.example = Convert YAML to JSON:\ndpa op yaml:to-json config.yaml
op.json.to.csv.example = Convert a JSON array to CSV:\ndpa op json:to-csv data.json
op.csv.to.json.example = Convert CSV to JSON:\ndpa op csv:to-json data.csv
op.json.pretty.example = Pretty-print JSON:\ndpa op json:pretty data.json\nWith 4-space indent:\ndpa op json:pretty --indent 4 data.json
op.md5.example = MD5 digest:\necho hello | dpa op md5
op.sha256.example = SHA-256 digest:\necho hello | dpa op sha256
op.uuid.example = Generate a random UUID v4:\ndpa op uuid
op.random.hex.example = Generate 16 random bytes as hex:\ndpa op random:hex
op.gzip.compress.example = Compress with gzip:\ndpa op gzip:compress --level 9 data.bin


# 示例
op.aes.encrypt.example = 用 16 字节十六进制密钥加密（CBC + 显式 IV）：
  echo secret | dpa op aes:encrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 00000000000000000000000000000000
以十六进制查看结果：
  echo secret | dpa op aes:encrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 00000000000000000000000000000000 --output-format hex
op.aes.decrypt.example = 用相同密钥/IV 解密十六进制密文：
  echo 1f3d2c... | dpa op aes:decrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 00000000000000000000000000000000 --output-format hex
op.hmac.example = 使用文本密钥计算 HMAC-SHA256：
  echo message | dpa op hmac --key secret --algo sha256

# 示例（op.<name>.example，与 ops/mod.rs 的 apply_examples 保持同步）
op.sort.example = 按行字母序排序：\ndpa op sort words.txt\n按数值排序：\ndpa op sort --type numeric numbers.txt
op.unique.example = 去除相邻重复行：\ndpa op unique words.txt
op.count.example = 统计行数（wc -l 风格）：\ndpa op count --mode lines words.txt
op.replace.example = 替换每行第一个匹配：\ndpa op replace --pattern foo --replacement bar words.txt
op.hmac.example = 使用十六进制密钥计算 HMAC-SHA256：\ndpa op hmac --key 00112233445566778899aabbccddeeff --algo sha256 data.bin
op.aes.encrypt.example = 使用十六进制密钥和 IV 进行 AES-256-CBC 加密：\ndpa op aes:encrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 000102030405060708090a0b0c0d0e0f plain.bin
op.aes.decrypt.example = 解密 AES-CBC 输出：\ndpa op aes:decrypt --key 00112233445566778899aabbccddeeff --mode cbc --iv 000102030405060708090a0b0c0d0e0f cipher.bin
op.base64.encode.example = 编码为 Base64：\necho hello | dpa op base64:encode
op.base64.decode.example = 解码 Base64：\necho aGVsbG8= | dpa op base64:decode
op.hex.encode.example = 将字节编码为十六进制：\necho hello | dpa op hex:encode\n使用冒号分隔符：\ndpa op hex:encode --delimiter : data.bin
op.hex.decode.example = 将十六进制解码回字节：\necho 68656c6c6f | dpa op hex:decode
op.url.encode.example = 对字符串进行 URL 编码：\necho "a b&c" | dpa op url:encode
op.timestamp.to.date.example = 将纪元毫秒转换为日期：\ndpa op timestamp:to:date 1728000000000 --unit ms
op.json.to.yaml.example = 将 JSON 转换为 YAML：\ndpa op json:to-yaml data.json
op.yaml.to.json.example = 将 YAML 转换为 JSON：\ndpa op yaml:to-json config.yaml
op.json.to.csv.example = 将 JSON 数组转换为 CSV：\ndpa op json:to-csv data.json
op.csv.to.json.example = 将 CSV 转换为 JSON：\ndpa op csv:to-json data.csv
op.json.pretty.example = 美化输出 JSON：\ndpa op json:pretty data.json\n使用 4 空格缩进：\ndpa op json:pretty --indent 4 data.json
op.md5.example = 计算 MD5 摘要：\necho hello | dpa op md5
op.sha256.example = 计算 SHA-256 摘要：\necho hello | dpa op sha256
op.uuid.example = 生成随机 UUID v4：\ndpa op uuid
op.random.hex.example = 生成 16 字节随机十六进制：\ndpa op random:hex
op.gzip.compress.example = 使用 gzip 压缩：\ndpa op gzip:compress --level 9 data.bin

